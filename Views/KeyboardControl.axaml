                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="~"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[~].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="1" Command="{Binding EditBindCommand}" CommandParameter="1">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="1"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[1].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="2" Command="{Binding EditBindCommand}" CommandParameter="2">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="2"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[2].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="3" Command="{Binding EditBindCommand}" CommandParameter="3">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="3"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[3].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="4" Command="{Binding EditBindCommand}" CommandParameter="4">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="4"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[4].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="5" Command="{Binding EditBindCommand}" CommandParameter="5">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="5"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[5].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="6" Command="{Binding EditBindCommand}" CommandParameter="6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="6"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[6].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="7" Command="{Binding EditBindCommand}" CommandParameter="7">
