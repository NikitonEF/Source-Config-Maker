<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="conmaker.Views.KeyboardControl"
             xmlns:vm="using:conmaker.ViewModels"
             x:DataType="vm:BindsPanelViewModel">

    <UserControl.Styles>
    <!-- Selector="Button" означает: применить ко всем элементам Button в этом файле -->
    <Style Selector="Button">
        <!-- Назначаем команду -->
        <Setter Property="Command" Value="{Binding EditBindCommand}" />
        <Setter Property="Focusable" Value="False"/>

        <!-- А вот тут магия! $self указывает на текущую кнопку. 
             Мы говорим: возьми свой собственный текст (Content) и отправь его как параметр! -->
        <Setter Property="CommandParameter" Value="{Binding $self.Content}" />
    </Style>
</UserControl.Styles>

    <Grid ColumnDefinitions="15*, 3*, 4*">
        <Border Grid.Column="0" Background="Maroon" Margin="0,0,0,0" />
            <Grid RowDefinitions="*, *, *, *, *, *">
                <Grid Grid.Row="0" ColumnDefinitions="1*, 0.5*, 1*, 1*, 1*, 1*, 0.5*, 1*, 1*, 1*, 1*, 0.5*, 1*, 1*, 1*, 1*" Margin="0,0,0,0">
                    <Button Grid.Column="0" Command="{Binding EditBindCommand}" CommandParameter="Esc">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="Esc"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[Esc].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="2" Command="{Binding EditBindCommand}" CommandParameter="F1">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F1"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F1].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="3" Command="{Binding EditBindCommand}" CommandParameter="F2">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F2"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F2].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="4" Command="{Binding EditBindCommand}" CommandParameter="F3">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F3"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F3].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="5" Command="{Binding EditBindCommand}" CommandParameter="F4">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F4"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F4].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="7" Command="{Binding EditBindCommand}" CommandParameter="F5">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F5"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F5].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="8" Command="{Binding EditBindCommand}" CommandParameter="F6">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F6"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F6].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="9" Command="{Binding EditBindCommand}" CommandParameter="F7">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F7"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F7].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="10" Command="{Binding EditBindCommand}" CommandParameter="F8">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F8"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F8].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="12" Command="{Binding EditBindCommand}" CommandParameter="F9">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F9"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F9].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="13" Command="{Binding EditBindCommand}" CommandParameter="F10">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F10"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F10].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="14" Command="{Binding EditBindCommand}" CommandParameter="F11">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F11"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F11].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="15" Command="{Binding EditBindCommand}" CommandParameter="F12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="F12"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[F12].CommandText, FallbackValue=''}"/>
