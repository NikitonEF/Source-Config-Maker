                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[-].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="12" Command="{Binding EditBindCommand}" CommandParameter="+">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="+"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[+].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="13" Command="{Binding EditBindCommand}" CommandParameter="Backspace">
                        <StackPanel>
