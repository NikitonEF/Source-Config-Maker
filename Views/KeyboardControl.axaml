                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[U].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="8" Command="{Binding EditBindCommand}" CommandParameter="I">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="I"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[I].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="9" Command="{Binding EditBindCommand}" CommandParameter="O">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="O"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[O].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="10" Command="{Binding EditBindCommand}" CommandParameter="P">
                        <StackPanel>
