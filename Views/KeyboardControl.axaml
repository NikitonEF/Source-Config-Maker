                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="7"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[7].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="8" Command="{Binding EditBindCommand}" CommandParameter="8">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="8"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[8].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="9" Command="{Binding EditBindCommand}" CommandParameter="9">
