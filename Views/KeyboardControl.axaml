                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[B].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="6" Command="{Binding EditBindCommand}" CommandParameter="N">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="N"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[N].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="7" Command="{Binding EditBindCommand}" CommandParameter="M">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="M"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[M].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="8" Command="{Binding EditBindCommand}" CommandParameter=",">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text=","/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[,].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="9" Command="{Binding EditBindCommand}" CommandParameter=".">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="."/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[.].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="10" Command="{Binding EditBindCommand}" CommandParameter="/">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="/"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[/].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="11" Command="{Binding EditBindCommand}" CommandParameter="SHIFT">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="SHIFT"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[SHIFT].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="5" ColumnDefinitions="1*, 1*, 1*, 5*, 1*, 1*, 1*, 1*">
                    <Button Grid.Column="0" Command="{Binding EditBindCommand}" CommandParameter="CTRL">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="CTRL"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[CTRL].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="1" Command="{Binding EditBindCommand}" CommandParameter="WIN">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="WIN"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[WIN].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="2" Command="{Binding EditBindCommand}" CommandParameter="ALT">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="ALT"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[ALT].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="3" Command="{Binding EditBindCommand}" CommandParameter="SPACE">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="SPACE"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[SPACE].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="4" Command="{Binding EditBindCommand}" CommandParameter="ALT">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="ALT"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[ALT].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="5" Command="{Binding EditBindCommand}" CommandParameter="FN">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="FN"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[FN].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="6" Command="{Binding EditBindCommand}" CommandParameter="MENU">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="MENU"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[MENU].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="7" Command="{Binding EditBindCommand}" CommandParameter="CNTR">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="CNTR"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[CNTR].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
                <Border Grid.Column="1" Background="DarkGreen" Margin="0,0,0,0" >
                    <Grid RowDefinitions="*, *, *, *, *, *" ColumnDefinitions="*, *, *" Margin="0,0,0,0" >
                        <Button Grid.Row="1" Grid.Column="0" Command="{Binding EditBindCommand}" CommandParameter="INS">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="INS"/>
