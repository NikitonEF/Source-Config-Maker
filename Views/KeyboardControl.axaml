                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[X].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="3" Command="{Binding EditBindCommand}" CommandParameter="C">
                        <StackPanel>
