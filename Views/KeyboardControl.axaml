                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[C].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="4" Command="{Binding EditBindCommand}" CommandParameter="V">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="V"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[V].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="5" Command="{Binding EditBindCommand}" CommandParameter="B">
                        <StackPanel>
