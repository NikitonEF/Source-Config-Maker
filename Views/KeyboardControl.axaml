                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="SHIFT"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[SHIFT].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="1" Command="{Binding EditBindCommand}" CommandParameter="Z">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="Z"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[Z].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="2" Command="{Binding EditBindCommand}" CommandParameter="X">
                        <StackPanel>
