                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[K].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="9" Command="{Binding EditBindCommand}" CommandParameter="L">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="L"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[L].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="10" Command="{Binding EditBindCommand}" CommandParameter=";">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text=";"/>
                            <TextBlock FontSize="10" Foreground="Gray" Text="{Binding Keys[;].CommandText, FallbackValue=''}"/>
                        </StackPanel>
                    </Button>
                                        <Button Grid.Column="11" Command="{Binding EditBindCommand}" CommandParameter="QUOTE">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Center" Text="'"/>
