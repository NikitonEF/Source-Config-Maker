<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SourceConfigMaker.ViewModels"
             xmlns:models="using:SourceConfigMaker.Models"
             x:Class="SourceConfigMaker.Views.PresetsView"
             x:DataType="vm:PresetsViewModel">

    <Grid RowDefinitions="*, Auto" Margin="10">
        <ListBox Grid.Row="0" ItemsSource="{Binding CurrentPresets}" SelectedItem="{Binding SelectedPreset}"
                 Background="Transparent" CornerRadius="4">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:PresetItem">
                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,3">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip.Tip="Включить в итоговый конфиг"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" VerticalAlignment="Center"/>
                        
                        <!-- Интерактивная кнопка закрепления для пользовательских алиасов -->
                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsPinned}" IsVisible="{Binding !IsBuiltIn}" 
                                      Background="Transparent" BorderThickness="0" Padding="5,0" Cursor="Hand"
                                      ToolTip.Tip="Закрепить алиас (не удалится при очистке)">
                            <Panel>
                                <TextBlock Text="📌" IsVisible="{Binding IsPinned}" Foreground="#DAA520" VerticalAlignment="Center"/>
                                <TextBlock Text="📍" IsVisible="{Binding !IsPinned}" Foreground="Gray" VerticalAlignment="Center"/>
                            </Panel>
                        </ToggleButton>

                        <TextBlock Grid.Column="3" Text="🔒" Foreground="Gray" IsVisible="{Binding IsBuiltIn}" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" ToolTip.Tip="Встроенный пресет"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,10,0,0">
            <Button Grid.Column="0" Content="+ Новый" Command="{Binding AddCustomPresetCommand}"
                    Background="#4682B4" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
            <Button Grid.Column="1" Content="Удалить" Command="{Binding DeleteSelectedPresetCommand}"
                    Background="#DC143C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>