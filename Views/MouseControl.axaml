<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="conmaker.Views.MouseControl"
             xmlns:vm="using:conmaker.ViewModels"
             x:DataType="vm:BindsPanelViewModel">
  
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Command" Value="{Binding EditBindCommand}" />
            <Setter Property="Focusable" Value="False"/>
            <!-- Теперь кнопка будет отправлять то, что лежит в скрытом кармане Tag -->
            <Setter Property="CommandParameter" Value="{Binding $self.Tag}" />
        </Style>
    </UserControl.Styles>    

    <Border Grid.Column="2" Background="#0909" Margin="0,0,0,0">
        <Grid RowDefinitions="0.2*, 2*, 2*, 2*, 2*, 0.2*" ColumnDefinitions="0.2*, *, *, *, *, 0.2*" Margin="0,0,0,0" >
            <Button Grid.Row="1" Grid.Column="2" Grid.RowSpan="4" CornerRadius="25, 0, 0, 100" Content="LMC" Tag="MOUSE1" />
            <Button Grid.Row="1" Grid.Column="4" Grid.RowSpan="4" CornerRadius="0, 25, 100, 0" Content="RMC" Tag="MOUSE2"/>
            <Button Grid.Row="2" Grid.Column="3" Content="MB" Tag="MOUSEUP" />
            <Button Grid.Row="1" Grid.Column="3" Content="UMB" Tag="MOUSEW" />
            <Button Grid.Row="3" Grid.Column="3" Content="DMB" Tag="MOUSEDWN" />
            <Button Grid.Row="2" Grid.Column="1" Grid.RowSpan="1" Content="M5" Tag="M5" CornerRadius="20, 0, 0, 0" />
            <Button Grid.Row="3" Grid.Column="1" Grid.RowSpan="1" Content="M4" Tag="M4" CornerRadius="0, 0, 0, 20" />
        </Grid>
    </Border>
    
</UserControl>
