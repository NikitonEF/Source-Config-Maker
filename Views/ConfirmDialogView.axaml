<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:conmaker.ViewModels"
        x:Class="conmaker.Views.ConfirmDialogView"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="420" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E23" Foreground="White">

    <StackPanel Margin="20" Spacing="25">
        <!-- Биндимся к свойству Message из нашей ViewModel -->
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
            <!-- Обрати внимание на суффикс 'Command', который генератор сам добавил к твоим методам Yes() и No() -->
            <Button Content="ДА" Command="{Binding YesCommand}" Background="#C85050" Foreground="White" Width="90" HorizontalContentAlignment="Center"/>
            <Button Content="НЕТ" Command="{Binding NoCommand}" Background="#2D2D32" Foreground="White" Width="90" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>