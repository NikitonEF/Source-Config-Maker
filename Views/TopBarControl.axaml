<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="50"
             x:Class="conmaker.Views.TopBarControl"

             xmlns:vm="using:conmaker.ViewModels"
             x:DataType="vm:TopBarViewModel">

    <UserControl.Styles>
        <Style Selector="Button.topMenu">
            <Setter Property="Background" Value="#25252B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0, 4, 0, 0" />
            <Setter Property="Padding" Value="20, 10" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.iconBtn">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Button.blueLine">
            <Setter Property="BorderBrush" Value="#4C90F0" />
        </Style>

        <Style Selector="Button.yellowLine">
            <Setter Property="BorderBrush" Value="#E5C02A" />
        </Style>

        <Style Selector="Button.greenLine">
            <Setter Property="BorderBrush" Value="#45C02A" />
        </Style>

        <Style Selector="Button.redLine">
            <Setter Property="BorderBrush" Value="#FF0000" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#45454C" />
        </Style>

        <Style Selector="Button.redIcon">
            <Setter Property="Background" Value="#CC3333" />
        </Style>

        <Style Selector="Button.redIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF4444" />
        </Style>
    </UserControl.Styles>

    <Border Background="#25252B" CornerRadius="0" Margin="0">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button Classes="topMenu greenLine" Content="СОХРАНИТЬ КОНФИГ" />
                <Button Classes="topMenu blueLine" Command="{Binding OpenConfigCommand}" Content="ОТКРЫТЬ КОНФИГ" />
                <Button Classes="topMenu yellowLine" Command="{Binding NewConfigCommand}" Content="НОВЫЙ КОНФИГ" />
                <Button Classes="topMenu redLine" Content="UNBINDALL" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Classes="iconBtn" Content="👁" />
                <Button Classes="iconBtn redIcon" Content="🎯" />
                <Button Classes="iconBtn" Content="⚙" />
                <Button Classes="iconBtn" Content="RU" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>