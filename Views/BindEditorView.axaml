<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:conmaker.ViewModels"
        x:Class="conmaker.Views.BindEditorView"
        x:DataType="vm:BindEditorViewModel"
        Title="Редактор бинда"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E23" Foreground="White">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="Кнопка:" Foreground="#A0A0A5" />
        <TextBox Text="{Binding BindKey}" Background="#25252B" Foreground="White" BorderBrush="#333333" IsReadOnly="True" />
        
        <TextBlock Text="Команда:" Foreground="#A0A0A5" />
        <TextBox Text="{Binding BindCommand}" Background="#25252B" Foreground="White" BorderBrush="#333333" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 10, 0, 0">
            <Button Content="ОТМЕНА" Command="{Binding CancelCommand}" Background="#2D2D32" Foreground="White" Width="90" HorizontalContentAlignment="Center"/>
            <Button Content="СОХРАНИТЬ" Command="{Binding SaveCommand}" Background="#4C90F0" Foreground="White" Width="100" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>