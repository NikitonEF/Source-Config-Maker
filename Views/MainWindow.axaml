<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SourceConfigMaker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SourceConfigMaker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:views="using:SourceConfigMaker.Views"
        Title="Source Config Maker"
        Width="1650" Height="800"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        Background="{Binding AppBackground}">

    <Grid RowDefinitions="30, *">
        
        <Panel x:Name="TitleBar" Background="{Binding TitleBarBackground}" Grid.Row="0" PointerPressed="TitleBar_PointerPressed">
            <TextBlock Foreground="Gray" VerticalAlignment="Center" Margin="15,0" />
        </Panel>

        <Grid Grid.Row="1" RowDefinitions="50, *">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto, Auto, Auto" Margin="20,5,20,5">
                
                <Button Grid.Column="0" Content="ОТКРЫТЬ КОНФИГ" 
                        Command="{Binding OpenConfigCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12"
                        BorderBrush="#4682B4" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Padding="15,8"/>
                        
                <Button Grid.Column="1" Content="НОВЫЙ КОНФИГ" 
                        Command="{Binding PromptNewConfigCommand}"
                        Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12"
                        BorderBrush="#DAA520" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Padding="15,8"/>
                        
                <Button Grid.Column="2" Content="СОХРАНИТЬ И БЭКАП" 
                        Command="{Binding SaveConfigCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12"
                        BorderBrush="#3CB371" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Padding="15,8"/>

                <Button Grid.Column="3" Content="UNBINDALL" 
                        Command="{Binding ToggleUnbindAllCommand}"
                        Background="{Binding UnbindAllColor}" Foreground="White" FontWeight="Bold" FontSize="12"
                        BorderBrush="#C85050" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Padding="15,8"/>
                        
                <Button Grid.Column="5" Content="👁" 
                        Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="16"
                        BorderBrush="#4682B4" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>

                <Button Grid.Column="6" Content="🎯" 
                        Command="{Binding ToggleCrosshairCommand}"
                        Background="{Binding CrosshairToggleColor}" Foreground="White" FontSize="16"
                        BorderBrush="#B43C3C" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>

                <Button Grid.Column="7" Content="{Binding ThemeIcon}" 
                        Command="{Binding ToggleThemeCommand}"
                        Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="16"
                        BorderBrush="{Binding ThemeHatColor}" BorderThickness="0,3,0,0" CornerRadius="4" 
                        Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>

                <ComboBox Grid.Column="8" SelectedIndex="0"
                          Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="13" FontWeight="Bold"
                          BorderBrush="#9370DB" BorderThickness="0,3,0,0" CornerRadius="4"
                          Padding="10,8" VerticalAlignment="Stretch">
                    <ComboBoxItem>RU</ComboBoxItem>
                    <ComboBoxItem>EN</ComboBoxItem>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*">
                <Grid Grid.Column="1" RowDefinitions="3*, 2*">
                    <Border Grid.Row="0" Background="{Binding KeyboardBackground}" Padding="10">
                        <views:KeyboardView DataContext="{Binding KeyboardVm}" />
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="17*, 5*">
                        <Border Grid.Column="0" Background="{Binding SettingsBackground}">
                            <views:SettingsView DataContext="{Binding SettingsVm}" />
                        </Border>
                        <Border Grid.Column="1" Background="{Binding MouseBackground}">
                            <views:MouseView DataContext="{Binding KeyboardVm}" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ОВЕРЛЕЙ РЕДАКТИРОВАНИЯ БИНДА -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" 
              Background="#99000000" IsVisible="{Binding IsEditorOpen}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{Binding AppBackground}" Width="400" Height="220" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    CornerRadius="8" Padding="15" BorderBrush="#3D3D42" BorderThickness="1">
                <Grid>
                    <Button Content="✕" Command="{Binding CancelEditCommand}"
                            Background="Transparent" Foreground="#DC143C" 
                            FontSize="18" FontWeight="Bold" Padding="5,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Cursor="Hand" BorderThickness="0" Margin="0,-5,-5,0"/>

                    <StackPanel VerticalAlignment="Center" Spacing="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                            <TextBlock Text="{Binding EditingKeyName, StringFormat='ИЗМЕНИТЬ БИНД: {0}'}" 
                                       Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button Content="{Binding DefaultBindHint}" 
                                    Command="{Binding ApplyDefaultBindCommand}"
                                    IsVisible="{Binding HasDefaultBind}"
                                    Foreground="DodgerBlue" Background="Transparent" Padding="0" 
                                    Cursor="Hand" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Команда (бинд):" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                        <AutoCompleteBox Text="{Binding EditingCommandText, Mode=TwoWay}" 
                                     ItemsSource="{Binding PopularCommands}" FilterMode="Contains"
                                     MinimumPrefixLength="1" PlaceholderText="Начните вводить команду..."
                                     Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" Height="35"/>
                        <Grid ColumnDefinitions="*, *, *" Margin="0,15,0,0">
                            <Button Grid.Column="0" Content="UNBIND" Command="{Binding SaveBindCommand}"
                                    CommandParameter="UNBIND" Background="#DC143C" Foreground="White"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                            <Border Grid.Column="1" Margin="2.5,0,2.5,0"></Border>
                            <Button Grid.Column="2" Content="ОК" Command="{Binding SaveBindCommand}" 
                                    Background="#4682B4" Foreground="White"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ НОВОГО КОНФИГА -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" 
              Background="#99000000" IsVisible="{Binding IsNewConfigDialogOpen}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{Binding AppBackground}" Width="350" Height="150" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    CornerRadius="8" Padding="20" BorderBrush="#DAA520" BorderThickness="0,3,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="15">
                    <TextBlock Text="Создать новый конфиг?" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Все несохраненные изменения будут потеряны." Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="ОТМЕНА" Command="{Binding CancelNewConfigCommand}"
                                Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="ДА, ОЧИСТИТЬ" Command="{Binding ConfirmNewConfigCommand}" 
                                Background="#DAA520" Foreground="White" FontWeight="Bold"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>