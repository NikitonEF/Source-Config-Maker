<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SourceConfigMaker.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SourceConfigMaker.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:views="using:SourceConfigMaker.Views"
        Title="Source Config Maker"
        Width="1650" Height="800"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        Background="{Binding AppBackground}"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="30, *">

        <Panel x:Name="TitleBar" Background="Transparent" Grid.Row="0" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0" Spacing="10">
                    <Image Source="/Assets/HLCM.ico" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Source Config Maker" Foreground="Gray" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <Button Content="🗕" Click="MinimizeButton_Click" Background="Transparent" Foreground="Gray" FontSize="14" Width="45" Height="30" BorderThickness="0" CornerRadius="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="🗗" Click="MaximizeButton_Click" Background="Transparent" Foreground="Gray" FontSize="14" Width="45" Height="30" BorderThickness="0" CornerRadius="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="Gray" FontSize="14" Width="45" Height="30" BorderThickness="0" CornerRadius="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Panel>

        <Grid Grid.Row="1" RowDefinitions="50, *">
            <!-- ОБРАТИ ВНИМАНИЕ: Добавлена новая колонка (Grid.Column="4") для кнопки сброса -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto, Auto, Auto, Auto" Margin="20,5,20,5">

                <Button Classes="DynamicColorBtn" Grid.Column="0" Content="{DynamicResource Lang_OpenConfig}" Command="{Binding OpenConfigCommand}" CommandParameter="{Binding $parent[Window]}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12" BorderBrush="#4682B4" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Padding="15,8"/>
                <Button Classes="DynamicColorBtn" Grid.Column="1" Content="{DynamicResource Lang_NewConfig}" Command="{Binding PromptNewConfigCommand}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12" BorderBrush="#DAA520" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Padding="15,8"/>
                <Button Classes="DynamicColorBtn" Grid.Column="2" Content="{DynamicResource Lang_SaveBackup}" Command="{Binding SaveConfigCommand}" CommandParameter="{Binding $parent[Window]}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12" BorderBrush="#3CB371" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Padding="15,8"/>
                
                <!-- ИСПРАВЛЕНО: Foreground теперь берется из TopBarForeground, чтобы синхронизироваться с темой -->
                <Button Classes="DynamicColorBtn" Grid.Column="3" Content="{DynamicResource Lang_UnbindAll}" Command="{Binding ToggleUnbindAllCommand}" Background="{Binding UnbindAllColor}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12" BorderBrush="#C85050" BorderThickness="0,3,0,0" CornerRadius="4" Padding="15,8" Margin="0,0,10,0"/>
                
                <Button Classes="DynamicColorBtn" Grid.Column="4" Content="↺ Reset Binds" Command="{Binding PromptResetBindsCommand}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="12" BorderBrush="#FF8C00" BorderThickness="0,3,0,0" CornerRadius="4" Padding="15,8"/>

                <Button Classes="DynamicColorBtn" Grid.Column="6" Content="👁" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="16" BorderBrush="#4682B4" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>
                
                <!-- ИСПРАВЛЕНО: Foreground="{Binding TopBarForeground}" -->
                <Button Classes="DynamicColorBtn" Grid.Column="7" Content="🎯" Command="{Binding ToggleCrosshairCommand}" Background="{Binding CrosshairToggleColor}" Foreground="{Binding TopBarForeground}" FontSize="16" BorderBrush="#B43C3C" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>
                
                <Button Classes="DynamicColorBtn" Grid.Column="8" Content="{Binding ThemeIcon}" Command="{Binding ToggleThemeCommand}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="16" BorderBrush="{Binding ThemeHatColor}" BorderThickness="0,3,0,0" CornerRadius="4" Margin="0,0,10,0" Width="42" Padding="0,8" HorizontalContentAlignment="Center"/>
                <ComboBox Grid.Column="9" SelectedIndex="0" Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" FontSize="13" FontWeight="Bold" BorderBrush="#9370DB" BorderThickness="0,3,0,0" CornerRadius="4" Padding="10,8" VerticalAlignment="Stretch">
                    <ComboBoxItem Tag="en">EN</ComboBoxItem>
                    <ComboBoxItem Tag="ru">RU</ComboBoxItem>
                    <ComboBoxItem Tag="de">DE</ComboBoxItem>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*">
                <Grid Grid.Column="1" RowDefinitions="3*, 2*">
                    <Border Grid.Row="0" Background="{Binding KeyboardBackground}" Padding="10">
                        <views:KeyboardView DataContext="{Binding KeyboardVm}" />
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="17*, 5*">
                        <Border Grid.Column="0" Background="{Binding SettingsBackground}">
                            <views:SettingsView DataContext="{Binding SettingsVm}" />
                        </Border>
                        <Border Grid.Column="1" Background="{Binding MouseBackground}">
                            <views:MouseView DataContext="{Binding KeyboardVm}" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ОВЕРЛЕЙ РЕДАКТИРОВАНИЯ БИНДА (Возвращен к оригиналу) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding IsEditorOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{Binding AppBackground}" Width="400" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="15" BorderBrush="#3D3D42" BorderThickness="1">
                <Grid>
                    <Button Content="✕" Command="{Binding CancelEditCommand}" Background="Transparent" Foreground="#DC143C" FontSize="18" FontWeight="Bold" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" BorderThickness="0" Margin="0,-5,-5,0"/>
                    <StackPanel VerticalAlignment="Center" Spacing="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Lang_EditBindTitle}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EditingKeyName}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasDefaultBind}" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Lang_DefaultBindPrefix}" Foreground="Gray" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="{Binding DefaultBindHint}" Command="{Binding ApplyDefaultBindCommand}" Foreground="DodgerBlue" Background="Transparent" FontSize="13" Padding="0" Cursor="Hand" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Lang_DefaultBindSuffix}" Foreground="Gray" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        <TextBlock Text="{DynamicResource Lang_CommandLabel}" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
                        <AutoCompleteBox Text="{Binding EditingCommandText, Mode=TwoWay}" ItemsSource="{Binding PopularCommands}" FilterMode="Contains" MinimumPrefixLength="1" PlaceholderText="{DynamicResource Lang_CommandPlaceholder}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" Height="35"/>
                        <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                            <Button Grid.Column="0" Content="{DynamicResource Lang_Btn_Unbind}" Command="{Binding SaveBindCommand}" CommandParameter="UNBIND" Background="#DC143C" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="{DynamicResource Lang_Btn_Ok}" Command="{Binding SaveBindCommand}" Background="#4682B4" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ НОВОГО КОНФИГА -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding IsNewConfigDialogOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{Binding AppBackground}" Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="20" BorderBrush="#DAA520" BorderThickness="0,3,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="15">
                    <TextBlock Text="{DynamicResource Lang_NewConfigTitle}" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Lang_NewConfigDesc}" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="{DynamicResource Lang_Btn_Cancel}" Command="{Binding CancelNewConfigCommand}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="{DynamicResource Lang_Btn_YesClear}" Command="{Binding ConfirmNewConfigCommand}" Background="#DAA520" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ СБРОСА БИНДОВ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#99000000" IsVisible="{Binding IsResetBindsDialogOpen}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{Binding AppBackground}" Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="20" BorderBrush="#FF8C00" BorderThickness="0,3,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="15">
                    <TextBlock Text="Reset all binds to default?" Foreground="{Binding TopBarForeground}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="This will replace all keys with game defaults." Foreground="Gray" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="{DynamicResource Lang_Btn_Cancel}" Command="{Binding CancelResetBindsCommand}" Background="{Binding TopBarButtonBackground}" Foreground="{Binding TopBarForeground}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                        <Button Grid.Column="1" Content="Reset" Command="{Binding ConfirmResetBindsCommand}" Background="#FF8C00" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>