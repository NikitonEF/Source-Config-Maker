<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"             
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="conmaker.Views.PresetsPanelControl">

    <UserControl.Styles>

    </UserControl.Styles>

    <Grid Grid.Column="0" RowDefinitions="Auto, *">
        <Border Grid.Row="1" Background="#25252B" Margin="0,0,0,10">
            <TextBlock Text="Здесь будет список пресетов" Foreground="Gray" 
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
            <StackPanel Grid.Row="0" Spacing="5">
            <Button Content="+ Добавить алиас" Classes="topMenu greenLine" />
        </StackPanel>
    </Grid>

</UserControl>
